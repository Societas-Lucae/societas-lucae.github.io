---
import '~/styles/global.css';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import CookieConsent from '~/components/layout/CookieConsent.astro';
import Seo, { type SeoProps } from '~/components/layout/Seo.astro';

interface Props extends SeoProps {
  bodyClass?: string;
}
const { bodyClass = '', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2e5984" />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class={`flex min-h-dvh flex-col ${bodyClass}`}>
    <a
      href="#main"
      class="focus:bg-navy sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
