---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { getSite } from '~/lib/content';

/**
 * Inlines the landscape logo SVG so it can scale crisply and inherit no
 * external request. The file is managed from the admin (site settings > logo).
 */
interface Props {
  class?: string;
}
const { class: className = 'h-10 w-auto' } = Astro.props;
const site = await getSite();

const svgPath = fileURLToPath(new URL(`../../..${site.logo}`, import.meta.url));
let svg = readFileSync(svgPath, 'utf8')
  .replace(/<\?xml[^>]*>/, '')
  .replace(/<!DOCTYPE[^>]*>/, '')
  .replace(/\s(width|height)="[^"]*"/g, '');
svg = svg.replace('<svg', `<svg class="${className}" role="img" aria-label="${site.name}" focusable="false"`);
---

<Fragment set:html={svg} />
