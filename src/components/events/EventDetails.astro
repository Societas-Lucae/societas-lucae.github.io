---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { EventEntry } from '~/lib/content';
import { resolveImage } from '~/lib/images';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import EventMeta from '~/components/events/EventMeta.astro';

/**
 * Full content of an event: used both inside the modal on the home page
 * and on the event's own page.
 */
interface Props {
  event: EventEntry;
  categoryTitle: string;
  headingLevel?: 'h1' | 'h2';
  headingId?: string;
}
const { event, categoryTitle, headingLevel: Heading = 'h2', headingId } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const hasBody = (event.body ?? '').trim().length > 0;
const cover = resolveImage(data.image || '');
const gallery = data.gallery.map((path) => ({ path, image: resolveImage(path) })).filter((g) => g.image);
const primaryLinks = data.links.filter((l) => l.primary);
const otherLinks = data.links.filter((l) => !l.primary);
---

<article class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10">
  <div class="min-w-0">
    <p class="font-heading text-gold-600 text-sm font-bold tracking-[0.18em] uppercase">{categoryTitle}</p>
    <Heading
      id={headingId}
      class="font-heading text-navy mt-2 text-2xl leading-tight font-bold text-balance sm:text-3xl"
    >
      {data.title}
    </Heading>
    <EventMeta event={event} class="mt-4" />

    <p class="text-ink/85 mt-5 text-[17px] leading-relaxed">{data.summary}</p>

    {
      data.speakers.length > 0 && (
        <section class="mt-6" aria-label="Speakers">
          <h3 class="font-heading text-navy text-sm font-bold tracking-[0.18em] uppercase">
            {data.speakers.length > 1 ? 'Speakers' : 'Speaker'}
          </h3>
          <ul class="mt-3 grid gap-3">
            {data.speakers.map((s) => (
              <li class="flex gap-3">
                <span class="text-navy inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-sky-100">
                  <Icon name="user" class="size-4.5" />
                </span>
                <div>
                  <p class="text-ink font-semibold">{s.name}</p>
                  {s.role && <p class="text-ink/70 text-sm">{s.role}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasBody && (
        <div class="text-ink/80 [&_a]:text-navy [&_a]:decoration-gold [&_blockquote]:border-gold [&_blockquote]:text-ink/75 mt-6 space-y-4 text-[15px] leading-relaxed [&_a]:font-semibold [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-4 [&_blockquote]:pl-4 [&_blockquote]:italic [&_em]:italic [&_strong]:font-semibold">
          <Content />
        </div>
      )
    }

    {
      data.links.length > 0 && (
        <div class="mt-7 flex flex-wrap gap-3">
          {primaryLinks.map((l) => (
            <Button href={l.url} target="_blank" variant="gold">
              {l.label}
              <Icon name="external" class="size-4" />
            </Button>
          ))}
          {otherLinks.map((l) => (
            <Button href={l.url} target="_blank" variant="secondary">
              {l.label}
              <Icon name="external" class="size-4" />
            </Button>
          ))}
        </div>
      )
    }

    {
      gallery.length > 0 && (
        <section class="mt-8" aria-label="Photos and flyers">
          <h3 class="font-heading text-navy text-sm font-bold tracking-[0.18em] uppercase">Gallery</h3>
          <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {gallery.map(({ image }) => (
              <li>
                <a
                  href={image!.src}
                  target="_blank"
                  rel="noopener"
                  class="group block overflow-hidden rounded-2xl bg-sky-50"
                >
                  <Image
                    src={image!}
                    alt=""
                    widths={[320, 480, 640]}
                    sizes="(min-width: 640px) 14rem, 45vw"
                    class="aspect-square w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  {
    cover && (
      <aside class="order-first lg:order-none">
        <Image
          src={cover}
          alt={`Flyer: ${data.title}`}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 1024px) 18rem, 100vw"
          class:list={[
            'shadow-navy/10 mx-auto w-full max-w-[17rem] shadow-lg sm:max-w-sm lg:max-w-none',
            data.coverSquareCorners ? 'rounded-none' : 'rounded-2xl',
          ]}
          loading="lazy"
        />
      </aside>
    )
  }
</article>
