---
import { Image } from 'astro:assets';
import type { EventEntry } from '~/lib/content';
import { formatEventDates } from '~/lib/content';
import { resolveImage } from '~/lib/images';
import Icon from '~/components/ui/Icon.astro';

/**
 * Compact card. Clicking opens the event's modal (progressive enhancement:
 * without JavaScript the link goes to the event page).
 */
interface Props {
  event: EventEntry;
  variant?: 'upcoming' | 'past';
}
const { event, variant = 'past' } = Astro.props;
const { data } = event;
const cover = resolveImage(data.image || '');
const href = `/events/${event.id}`;
const dialogId = `event-${event.id}`;
---

{
  variant === 'upcoming' ? (
    <a
      href={href}
      data-event-open={dialogId}
      class="group border-gold/40 ring-honey/50 hover:shadow-navy/10 grid gap-5 rounded-3xl border bg-white p-5 shadow-sm ring-4 transition hover:-translate-y-0.5 hover:shadow-lg sm:grid-cols-[9rem_1fr] sm:p-6"
    >
      {cover && (
        <Image
          src={cover}
          alt=""
          widths={[288, 432]}
          sizes="9rem"
          class="aspect-[4/5] w-full rounded-2xl object-cover sm:w-36"
          loading="lazy"
        />
      )}
      <div class="min-w-0">
        <p class="bg-gold font-heading text-ink inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-bold tracking-wider uppercase">
          Upcoming
        </p>
        <h4 class="font-heading text-navy group-hover:decoration-gold mt-3 text-xl leading-snug font-bold group-hover:underline group-hover:underline-offset-4">
          {data.title}
        </h4>
        <p class="text-ink/75 mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[15px]">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="calendar" class="text-navy size-4" />
            {formatEventDates(event)}
          </span>
          {data.location && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name={data.online ? 'video' : 'pin'} class="text-navy size-4" />
              {data.location}
            </span>
          )}
        </p>
        <p class="text-ink/75 mt-3 line-clamp-3 text-[15px] leading-relaxed">{data.summary}</p>
        <span class="font-heading text-navy mt-4 inline-flex items-center gap-1.5 text-sm font-semibold">
          See details
          <Icon name="arrow" class="size-4 transition group-hover:translate-x-0.5" />
        </span>
      </div>
    </a>
  ) : (
    <a
      href={href}
      data-event-open={dialogId}
      class="group border-navy/10 hover:border-navy/20 hover:shadow-navy/10 flex flex-col overflow-hidden rounded-2xl border bg-white transition hover:-translate-y-0.5 hover:shadow-lg"
    >
      <div class="aspect-[4/5] w-full overflow-hidden bg-sky-50">
        {cover ? (
          <Image
            src={cover}
            alt=""
            widths={[240, 360, 480]}
            sizes="(min-width: 1024px) 14rem, (min-width: 640px) 30vw, 45vw"
            class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
            loading="lazy"
          />
        ) : (
          <div class="text-sky flex h-full items-center justify-center">
            <Icon name="calendar" class="size-10" />
          </div>
        )}
      </div>
      <div class="flex flex-1 flex-col p-4">
        <p class="text-ink/60 text-xs font-semibold tracking-wide uppercase">{formatEventDates(event)}</p>
        <h4 class="font-heading text-navy group-hover:decoration-gold mt-1 line-clamp-3 text-[15px] leading-snug font-bold group-hover:underline group-hover:underline-offset-4">
          {data.title}
        </h4>
        {data.location && <p class="text-ink/60 mt-1 line-clamp-1 text-xs">{data.location}</p>}
      </div>
    </a>
  )
}
