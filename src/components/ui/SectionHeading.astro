---
interface Props {
  id?: string;
  tagline?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  as?: 'h2' | 'h3';
  class?: string;
}
const {
  id,
  tagline,
  title,
  intro,
  align = 'left',
  tone = 'dark',
  as: Tag = 'h2',
  class: className = '',
} = Astro.props;
const alignment = align === 'center' ? 'mx-auto text-center' : '';
const taglineColor = tone === 'light' ? 'text-honey' : 'text-gold-600';
const titleColor = tone === 'light' ? 'text-white' : 'text-navy';
const introColor = tone === 'light' ? 'text-sky-100' : 'text-muted';
---

<div class={`max-w-2xl ${alignment} ${className}`}>
  {
    tagline && (
      <p class={`font-heading mb-3 text-sm font-bold tracking-[0.18em] uppercase ${taglineColor}`}>
        {tagline}
      </p>
    )
  }
  <Tag
    id={id}
    class={`font-heading text-3xl leading-tight font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem] ${titleColor}`}
  >
    {title}
  </Tag>
  {intro && <p class={`mt-4 text-lg leading-relaxed text-pretty ${introColor}`}>{intro}</p>}
</div>
