---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
---

<BaseLayout title="Page not found" noindex>
  <Container size="narrow" class="py-20 text-center sm:py-28">
    <p class="font-heading text-gold-600 text-sm font-bold tracking-[0.18em] uppercase">Error 404</p>
    <h1 class="font-heading text-navy mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="text-muted mt-4 text-lg">The page you are looking for does not exist or has moved.</p>
    <div class="mt-8 flex justify-center">
      <Button href="/" size="lg">
        <Icon name="arrow" class="size-5 rotate-180" />
        Back to the home page
      </Button>
    </div>
  </Container>
</BaseLayout>
