---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/ui/Container.astro';
import { getHome } from '~/lib/content';

const { hero } = await getHome();
---

<BaseLayout>
  <Container class="py-16 sm:py-24">
    <h1 class="font-heading text-navy text-4xl font-bold tracking-tight sm:text-5xl">{hero.title}</h1>
    <p class="text-muted mt-4 text-lg">Site under construction.</p>
  </Container>
</BaseLayout>
